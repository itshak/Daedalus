# Only public, non-secret values are allowed in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Server-only aliases, preferably same values but intentionally not NEXT_PUBLIC_
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
DAEDALUS_API_BASE_URL=https://api.daedalus.tongrix.com
DAEDALUS_API_TOKEN=<existing-strong-daedalus-api-bearer-set-in-vercel-only>
DAEDALUS_LEGACY_API_ORIGIN=https://api.daedalus.tongrix.com
